rules_version = '2';
// Server-only model:
// offers/{kind:id}: public catalogue fields plus private lesson content; returned
// through API projections only. No client SDK may read the complete document.
// roles/{uid}: privileged role and suspension; never client-writable.
// orders/{orderId}, payments/{paymentId}: immutable uid, amount, currency,
// provider IDs and server-verified payment status.
// enrolments/{uid}/items/{kind:id}: per-order grants, active status and owner.
// paymentEvents/{eventHash}: idempotent webhook processing records.
// audit/{id}: server-generated administrator activity records.
// profiles/{uid}/learning/{courseId}: private progress, notes and submissions.
// certificates: server-issued completion and revocation records.
// discussionPosts, discussionThrottle: course messages and posting limits.
// mentorshipOffers, mentorshipBookings, mentorshipSlots, mentorshipCounters:
// validated offers, private requests, transactional slot locks and request limits.
// All access goes through the Vercel backend, which verifies Firebase identity,
// role/ownership, validates fields and uses atomic Firestore transactions.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
